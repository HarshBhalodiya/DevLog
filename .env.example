# ─────────────────────────────────────────────────────────────
# DevLog — Single Environment File (project root)
# Copy this to .env (same directory) and fill in your values
# ─────────────────────────────────────────────────────────────

# ── Backend (FastAPI) ────────────────────────────────────────
# Groq API key for AI features (summary, analysis, weekly)
# Get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# CORS origins — comma-separated, no spaces
# For local dev:
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# For production, replace with your frontend URL:
# CORS_ORIGINS=https://your-app.netlify.app

# For production, set PostgreSQL connection string:
# DATABASE_URL=postgresql://user:pass@host:5432/devlog

# ── Frontend (Vite — VITE_ prefix is required) ───────────────
# Backend API URL
# For local development (FastAPI runs on port 8000):
VITE_API_URL=http://localhost:8000
# For production, set to your Render backend URL:
# VITE_API_URL=https://your-backend.onrender.com
